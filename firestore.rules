rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'adwwaw@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprints
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.role is string && data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidSiteVisit(data) {
      return data.keys().hasAll(['visitorHash', 'dateKey', 'lang', 'path', 'createdAt']) &&
        data.keys().hasOnly(['visitorHash', 'dateKey', 'lang', 'path', 'createdAt']) &&
        data.visitorHash is string && data.visitorHash.size() >= 8 && data.visitorHash.size() <= 64 &&
        data.visitorHash.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.dateKey is string && data.dateKey.size() == 10 &&
        data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.lang in ['ar', 'fr', 'en'] &&
        data.path in ['portal', 'studio', 'guide', 'history'] &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedPrompt(data) {
      return data.keys().hasAll([
          'uid', 'title', 'engine', 'mode', 'category', 'shotsCount',
          'source', 'prompt', 'positiveOnly', 'negativeOnly',
          'isFavorite', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'title', 'engine', 'mode', 'category', 'shotsCount',
          'source', 'prompt', 'positiveOnly', 'negativeOnly',
          'isFavorite', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.engine in ['wan22', 'minimax', 'veo', 'hunyuan', 'ltx', 'flux1', 'sdxl'] &&
        data.mode in ['t2v', 'i2v', 'flf2v', 's2v', 'film', 't2i', 'img2img'] &&
        data.category is string && data.category.size() <= 100 &&
        data.shotsCount is int && data.shotsCount >= 1 && data.shotsCount <= 60 &&
        data.source in ['studio', 'generator_v1', 'director_v2'] &&
        data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 20000 &&
        data.positiveOnly is string && data.positiveOnly.size() <= 20000 &&
        data.negativeOnly is string && data.negativeOnly.size() <= 4000 &&
        data.isFavorite is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsistencyNotes(notes) {
      return notes is map &&
        notes.keys().hasAll(['character', 'palette', 'lens']) &&
        notes.keys().hasOnly(['character', 'palette', 'lens']) &&
        notes.character is string && notes.character.size() <= 1000 &&
        notes.palette is string && notes.palette.size() <= 1000 &&
        notes.lens is string && notes.lens.size() <= 1000;
    }

    function isValidSavedSequence(data) {
      return data.keys().hasAll([
          'uid', 'title', 'idea', 'model', 'mode', 'style', 'lang',
          'shotLen', 'scenes', 'consistencyNotes', 'formattedOutput',
          'isFavorite', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'title', 'idea', 'model', 'mode', 'style', 'lang',
          'shotLen', 'scenes', 'consistencyNotes', 'formattedOutput',
          'isFavorite', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.idea is string && data.idea.size() >= 1 && data.idea.size() <= 2000 &&
        data.model in ['wan', 'minimax', 'google'] &&
        data.mode in ['normal', 'film', 'film_10'] &&
        data.style is string && data.style.size() <= 120 &&
        data.lang in ['ar', 'en'] &&
        data.shotLen is int && data.shotLen >= 1 && data.shotLen <= 60 &&
        data.scenes is list && data.scenes.size() >= 1 && data.scenes.size() <= 30 &&
        isValidConsistencyNotes(data.consistencyNotes) &&
        data.formattedOutput is string && data.formattedOutput.size() >= 1 && data.formattedOutput.size() <= 40000 &&
        data.isFavorite is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Verified Admin Registry (Admin-only)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(adminId) &&
        isAdmin() &&
        isValidAdminUser(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time;
      allow update: if isValidId(adminId) &&
        isAdmin() &&
        isValidAdminUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']);
      allow delete: if isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }

    // Real Visitor Counter Events (Write-only for visitors, Read/Delete only for Admin)
    match /visits/{visitId} {
      allow get: if isValidId(visitId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(visitId) &&
        isValidSiteVisit(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(visitId) && isAdmin();
    }

    // Registered User Profiles & Private Cloud Libraries
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Owner-only Saved Prompts subcollection
      match /prompts/{promptId} {
        allow get: if isValidId(userId) &&
          isValidId(promptId) &&
          isOwner(userId) &&
          (resource == null || existing().uid == request.auth.uid);
        allow list: if isValidId(userId) &&
          isOwner(userId) &&
          existing().uid == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(promptId) &&
          isOwner(userId) &&
          isValidSavedPrompt(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) &&
          isValidId(promptId) &&
          isOwner(userId) &&
          existing().uid == request.auth.uid &&
          isValidSavedPrompt(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'prompt', 'positiveOnly', 'negativeOnly',
            'isFavorite', 'shotsCount', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) &&
          isValidId(promptId) &&
          isOwner(userId) &&
          existing().uid == request.auth.uid;
      }

      // Owner-only Saved Film Sequences subcollection
      match /sequences/{sequenceId} {
        allow get: if isValidId(userId) &&
          isValidId(sequenceId) &&
          isOwner(userId) &&
          (resource == null || existing().uid == request.auth.uid);
        allow list: if isValidId(userId) &&
          isOwner(userId) &&
          existing().uid == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(sequenceId) &&
          isOwner(userId) &&
          isValidSavedSequence(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) &&
          isValidId(sequenceId) &&
          isOwner(userId) &&
          existing().uid == request.auth.uid &&
          isValidSavedSequence(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'idea', 'style', 'shotLen', 'scenes',
            'consistencyNotes', 'formattedOutput', 'isFavorite', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) &&
          isValidId(sequenceId) &&
          isOwner(userId) &&
          existing().uid == request.auth.uid;
      }
    }
  }
}
